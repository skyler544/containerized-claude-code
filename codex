#!/usr/bin/env bash
# Run Codex CLI in the container with the current directory as its workspace.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
exec "$SCRIPT_DIR/run-codex-container" \
    codex \
    --dangerously-bypass-approvals-and-sandbox \
    "$@"
