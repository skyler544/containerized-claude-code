#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$HOME/build/programming/containerized-agents/"
RUN_ACP=false
if [[ "${1:-}" == "--acp" ]]; then
	RUN_ACP=true
	shift
fi

CODEX_HOME_HOST="$HOME/.cache/codex-home"
WORKDIR="$PWD"
COMMON_PODMAN_ARGS=()

prepare_codex_home() {
	local global_agents_src="$SCRIPT_DIR/AGENTS.md"
	local global_agents_dest="$CODEX_HOME_HOST/AGENTS.md"

	mkdir -p "$CODEX_HOME_HOST"

	if [[ ! -e "$global_agents_dest" || "$global_agents_src" -nt "$global_agents_dest" ]]; then
		cp "$global_agents_src" "$global_agents_dest"
	fi
}

prepare_common_podman_args() {
	COMMON_PODMAN_ARGS=(
		--rm
		--userns=keep-id
		--cap-drop=ALL
		--security-opt=no-new-privileges:true
		--security-opt=label=disable
		--env GIT_OPTIONAL_LOCKS=0
		-v "$CODEX_HOME_HOST:/home/node/.codex"
		-v "$WORKDIR:$WORKDIR"
	)

	# Bind mount the workspace's Git metadata as read-only.
	if [[ -e "$WORKDIR/.git" ]]; then
		COMMON_PODMAN_ARGS+=(-v "$WORKDIR/.git:$WORKDIR/.git:ro")
	fi

	if [[ -d "$HOME/planning" ]]; then
		COMMON_PODMAN_ARGS+=(-v "$HOME/planning:$WORKDIR/planning:ro")
	fi

	COMMON_PODMAN_ARGS+=(--workdir "$WORKDIR")
}

run_codex_cli() {
	local tty_args=()

	if [[ -t 0 && -t 1 ]]; then
		tty_args=(-it)
	fi

	exec podman run \
		"${tty_args[@]}" \
		"${COMMON_PODMAN_ARGS[@]}" \
		codex-cli:latest \
		codex \
		--dangerously-bypass-approvals-and-sandbox \
		"$@"
}

ACP_STATE_DIR=
ACP_CONTAINER_ID_FILE=
ACP_RUNTIME_DIR=
ACP_TMP_DIR=
ACP_PODMAN_PID=

stop_codex_acp_container() {
	local container_id=

	trap - EXIT HUP INT TERM

	if [[ -n "$ACP_PODMAN_PID" ]]; then
		kill "$ACP_PODMAN_PID" 2>/dev/null || true
	fi
	if [[ -s "$ACP_CONTAINER_ID_FILE" ]]; then
		container_id="$(<"$ACP_CONTAINER_ID_FILE")"
		podman stop --ignore --time 1 "$container_id" >/dev/null 2>&1 || true
	fi
	if [[ -n "$ACP_PODMAN_PID" ]]; then
		wait "$ACP_PODMAN_PID" 2>/dev/null || true
	fi
	if [[ -n "$ACP_STATE_DIR" ]]; then
		rm -rf "$ACP_STATE_DIR"
	fi
}

run_codex_acp() {
	local tty_args=(-i)

	if [[ -t 0 && -t 1 ]]; then
		tty_args=(-it)
	fi

	# Podman keeps the ACP container alive after its stdio client disconnects.
	# Supervise it so closing the client also stops the container.
	ACP_STATE_DIR="$(mktemp -d)"
	ACP_CONTAINER_ID_FILE="$ACP_STATE_DIR/container-id"
	ACP_RUNTIME_DIR="$ACP_STATE_DIR/runtime"
	ACP_TMP_DIR="$ACP_STATE_DIR/tmp"
	mkdir -p "$ACP_RUNTIME_DIR" "$ACP_TMP_DIR"
	chmod 700 "$ACP_RUNTIME_DIR"

	trap stop_codex_acp_container EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM

	exec 3<&0
	podman run \
		"${tty_args[@]}" \
		--cidfile "$ACP_CONTAINER_ID_FILE" \
		--env XDG_RUNTIME_DIR=/tmp/codex-acp-runtime \
		--env TMPDIR=/tmp/codex-acp-tmp \
		--env INITIAL_AGENT_MODE=agent-full-access \
		-v "$ACP_RUNTIME_DIR:/tmp/codex-acp-runtime" \
		-v "$ACP_TMP_DIR:/tmp/codex-acp-tmp" \
		"${COMMON_PODMAN_ARGS[@]}" \
		codex-cli:latest \
		codex-acp \
		"$@" \
		<&3 &
	ACP_PODMAN_PID=$!
	exec 3<&-

	wait "$ACP_PODMAN_PID"
}

prepare_codex_home
prepare_common_podman_args

if [[ "$RUN_ACP" == true ]]; then
	run_codex_acp "$@"
else
	run_codex_cli "$@"
fi
