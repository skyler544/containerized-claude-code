#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$HOME/build/programming/containerized-agents/"
KEEP_STDIN_OPEN=false
if [[ "${1:-}" == "--keep-stdin-open" ]]; then
	KEEP_STDIN_OPEN=true
	shift
fi

COMMAND="${1:?missing command}"
shift

CODEX_HOME_HOST="$HOME/.cache/codex-home"
WORKDIR="$PWD"
GLOBAL_AGENTS_SRC="$SCRIPT_DIR/AGENTS.md"
GLOBAL_AGENTS_DEST="$CODEX_HOME_HOST/AGENTS.md"

mkdir -p "$CODEX_HOME_HOST"

if [[ ! -e "$GLOBAL_AGENTS_DEST" || "$GLOBAL_AGENTS_SRC" -nt "$GLOBAL_AGENTS_DEST" ]]; then
	cp "$GLOBAL_AGENTS_SRC" "$GLOBAL_AGENTS_DEST"
fi

TTY_FLAGS=()
if [[ "$KEEP_STDIN_OPEN" == true ]]; then
	TTY_FLAGS=(-i)
fi
if [[ -t 0 && -t 1 ]]; then
	TTY_FLAGS=(-it)
fi

# Bind mount the workspace's .git as read-only
GIT_MOUNT=()
if [[ -e "$WORKDIR/.git" ]]; then
	GIT_MOUNT=(-v "$WORKDIR/.git:$WORKDIR/.git:ro")
fi

PLANNING_MOUNTS=()
if [[ -d "$HOME/planning" ]]; then
	PLANNING_MOUNTS=(-v "$HOME/planning:$WORKDIR/planning:ro")
fi

PODMAN_RUN=(
	podman run
	"${TTY_FLAGS[@]}"
	--rm
	--userns=keep-id
	--cap-drop=ALL
	--security-opt=no-new-privileges:true
	--security-opt=label=disable
	--env GIT_OPTIONAL_LOCKS=0
	-v "$CODEX_HOME_HOST:/home/codex/.codex"
	-v "$WORKDIR:$WORKDIR"
	"${GIT_MOUNT[@]}"
	"${PLANNING_MOUNTS[@]}"
	--workdir "$WORKDIR"
	"codex-cli:latest"
	"$COMMAND"
	"$@"
)

if [[ "$KEEP_STDIN_OPEN" != true ]]; then
	exec "${PODMAN_RUN[@]}"
fi

# Podman's -i keeps the container's stdin open even after its attached client
# exits. Supervise that client so closing an ACP client also stops the container.
CID_DIR="$(mktemp -d)"
CID_FILE="$CID_DIR/container-id"
PODMAN_PID=

cleanup() {
	local container_id=

	trap - EXIT HUP INT TERM
	if [[ -n "$PODMAN_PID" ]]; then
		kill "$PODMAN_PID" 2>/dev/null || true
	fi
	if [[ -s "$CID_FILE" ]]; then
		container_id="$(<"$CID_FILE")"
		podman stop --ignore --time 1 "$container_id" >/dev/null 2>&1 || true
	fi
	if [[ -n "$PODMAN_PID" ]]; then
		wait "$PODMAN_PID" 2>/dev/null || true
	fi
	rm -rf "$CID_DIR"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

exec 3<&0
"${PODMAN_RUN[@]:0:2}" --cidfile "$CID_FILE" "${PODMAN_RUN[@]:2}" <&3 &
PODMAN_PID=$!
exec 3<&-
wait "$PODMAN_PID"
