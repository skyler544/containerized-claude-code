#!/usr/bin/env bash
set -euo pipefail

IMAGE_NAME="claude-cli"
IMAGE_TAG="latest"

CLAUDE_HOME="$HOME/.cache/claude-home"

# ── Workspace ─────────────────────────────────────────────────────────────────
HOST_WORKDIR="$PWD"
PROJECT_NAME="$(basename "$PWD")"
CONTAINER_WORKDIR="/home/claude/workspace/$PROJECT_NAME"

# ── Host path mounts ──────────────────────────────────────────────────────────
SHARED_LABEL_OPTS=()
if [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]]; then
    SHARED_LABEL_OPTS=(z)
fi

MOUNTS=()

add_bind_mount() {
    local host_path="$1" container_path="$2"
    shift 2
    local -a opts=("$@" "${SHARED_LABEL_OPTS[@]}")
    local spec="$host_path:$container_path"
    if (( ${#opts[@]} )); then
        local IFS=,
        spec+=":${opts[*]}"
    fi
    MOUNTS+=(-v "$spec")
}

EMPTY_DIR_OPTS="ro,noexec,nosuid,nodev"

# ── TTY detection ─────────────────────────────────────────────────────────────
TTY_FLAGS=()
if [[ -t 0 ]]; then
    TTY_FLAGS=(-it)
fi

# ── Secret masking ────────────────────────────────────────────────────────────
SECRET_FILE_GLOBS=(
    '.env' '.env.*'
    '.netrc' '.npmrc' '.pgpass' '.htpasswd' '.dockercfg'
    '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.keystore'
    'id_rsa*' 'id_ecdsa*' 'id_ed25519*'
    'credentials' 'credentials.json' 'service-account*.json'
    'secrets.yml' 'secrets.yaml' 'secrets.json'
)
SECRET_PATH_GLOBS=(
    '.claude/settings*.json'
)
SECRET_DIR_GLOBS=(
    '.ssh' '.gnupg' '.aws' '.kube' '.docker' '.gcloud'
    'secrets' 'secret'
)
SECRET_SKIP_DIRS=(
    '.git' 'node_modules' 'vendor' 'dist' 'build' '.cache'
)

MASK_SEARCH_DEPTH=6
EMPTY_FILE="/dev/null"

MASK_STUB_JSON="$CLAUDE_HOME/.mask/empty.json"
mkdir -p "$(dirname "$MASK_STUB_JSON")"
rm -f "$MASK_STUB_JSON"
printf "{}\\n" > "$MASK_STUB_JSON"
chmod 444 "$MASK_STUB_JSON"

SECRET_MASKS=()
WORKSPACE_MASK_RELPATHS=()
PLANNING_MASK_RELPATHS=()

mask_file() {
    local stub="$EMPTY_FILE"
    [[ "$1" == *.json ]] && stub="$MASK_STUB_JSON"
    SECRET_MASKS+=(-v "$stub:$1:ro")
}

mask_dir() {
    SECRET_MASKS+=(--tmpfs "$1:$EMPTY_DIR_OPTS")
}

append_glob_group() {
    local -n group_out="$1"
    local predicate="$2"
    shift 2
    local first=1 glob
    group_out+=('(')
    for glob in "$@"; do
        (( first )) || group_out+=(-o)
        group_out+=("$predicate" "$glob")
        first=0
    done
    group_out+=(')')
}

mask_tree() {
    local host_root="$1" container_root="$2"
    local -n relpaths_out="$3"
    [[ -d "$host_root" ]] || return 0

    local -a find_args=("$host_root" -maxdepth "$MASK_SEARCH_DEPTH")

    append_glob_group find_args -name "${SECRET_SKIP_DIRS[@]}"
    find_args+=(-prune -o)

    find_args+=(-type d)
    append_glob_group find_args -name "${SECRET_DIR_GLOBS[@]}"
    find_args+=(-prune -print -o)

    find_args+=(-type f)
    append_glob_group find_args -name "${SECRET_FILE_GLOBS[@]}"
    find_args+=(-print -o)

    local -a path_globs=() glob
    for glob in "${SECRET_PATH_GLOBS[@]}"; do
        path_globs+=("$host_root/$glob" "$host_root/*/$glob")
    done
    find_args+=(-type f)
    append_glob_group find_args -path "${path_globs[@]}"
    find_args+=(-print)

    local path rel
    while IFS= read -r path; do
        rel="${path#"$host_root"/}"
        if [[ -d "$path" ]]; then
            mask_dir "$container_root/$rel"
        else
            mask_file "$container_root/$rel"
        fi
        relpaths_out+=("$rel")
    done < <(find "${find_args[@]}" 2>/dev/null)
}

# ── Git snapshot ──────────────────────────────────────────────────────────────
SESSION_SNAPSHOT_PREFIX="claude-session"
GIT_EXCLUDE_RELPATHS=()
NO_EXTRA_EXCLUDES=()

remove_finished_session_snapshots() {
    local gitdir="$1" snapshot pid
    for snapshot in "$gitdir/$SESSION_SNAPSHOT_PREFIX".*; do
        [[ -d "$snapshot" ]] || continue
        pid="${snapshot##*.}"
        if [[ "$pid" == "$$" ]] || ! kill -0 "$pid" 2>/dev/null; then
            rm -rf "$snapshot"
        fi
    done
    find "$gitdir" -maxdepth 1 -name "$SESSION_SNAPSHOT_PREFIX.*" -mtime +0 \
        -exec rm -rf {} + 2>/dev/null || true
}

copy_git_dir() {
    local gitdir="$1" dest="$2" entry name written
    mkdir -p "$dest"
    for entry in "$gitdir"/* "$gitdir"/.[!.]*; do
        [[ -e "$entry" ]] || continue
        name="${entry##*/}"
        [[ "$name" == "$SESSION_SNAPSHOT_PREFIX".* ]] && continue
        cp -al "$entry" "$dest/" 2>/dev/null || cp -a "$entry" "$dest/"
    done

    mkdir -p "$dest/info"
    for written in "$dest/index" "$dest/info/exclude"; do
        [[ -f "$written" ]] || continue
        cp "$written" "$written.claude" && mv -f "$written.claude" "$written"
    done
}

hide_wrapper_mounts_from_git() {
    local snapshot="$1" worktree="$2"
    local -n relpaths_in="$3"
    local -n extra_excludes="$4"
    local -a git_cmd=(git --git-dir="$snapshot" --work-tree="$worktree")
    local rel list

    printf '\n# claude wrapper: masked and mounted paths\n' >> "$snapshot/info/exclude"

    list="$(mktemp)"
    for rel in "${relpaths_in[@]}"; do
        "${git_cmd[@]}" ls-files -z -- "$rel" > "$list" 2>/dev/null || true
        if [[ -s "$list" ]]; then
            xargs -0 -r "${git_cmd[@]}" update-index --skip-worktree -- < "$list"
        else
            printf '/%s\n' "$rel" >> "$snapshot/info/exclude"
        fi
    done
    rm -f "$list"

    for rel in "${extra_excludes[@]}"; do
        printf '/%s\n' "$rel" >> "$snapshot/info/exclude"
    done
}

add_git_snapshot() {
    local worktree="$1" gitdir="$2" container_git_path="$3" relpaths_name="$4" extra_excludes_name="$5"
    [[ -d "$gitdir" ]] || return 0

    local snapshot="$gitdir/$SESSION_SNAPSHOT_PREFIX.$$"
    remove_finished_session_snapshots "$gitdir"
    copy_git_dir "$gitdir" "$snapshot"
    hide_wrapper_mounts_from_git "$snapshot" "$worktree" "$relpaths_name" "$extra_excludes_name"
    add_bind_mount "$snapshot" "$container_git_path" ro
}

planning_directory() {
    local host_path="$1" name="$2"
    local container_path="$CONTAINER_WORKDIR/$name"

    add_bind_mount "$host_path" "$container_path"
    mask_tree "$host_path" "$container_path" PLANNING_MASK_RELPATHS
    add_git_snapshot "$host_path" "$host_path/.git" "$container_path/.git" PLANNING_MASK_RELPATHS NO_EXTRA_EXCLUDES
    GIT_EXCLUDE_RELPATHS+=("$name")
}

add_bind_mount "$CLAUDE_HOME" /home/claude
add_bind_mount "$HOST_WORKDIR" "$CONTAINER_WORKDIR"
mask_tree "$HOST_WORKDIR" "$CONTAINER_WORKDIR" WORKSPACE_MASK_RELPATHS
planning_directory "$HOME/planning" planning
add_git_snapshot "$HOST_WORKDIR" "$HOST_WORKDIR/.git" "$CONTAINER_WORKDIR/.git" WORKSPACE_MASK_RELPATHS GIT_EXCLUDE_RELPATHS

# ── Run ───────────────────────────────────────────────────────────────────────
exec podman run \
    "${TTY_FLAGS[@]}" \
    --rm \
    --userns=keep-id \
    --cap-drop=ALL \
    --security-opt=no-new-privileges:true \
    --network=bridge \
    "${MOUNTS[@]}" \
    "${SECRET_MASKS[@]}" \
    --workdir "$CONTAINER_WORKDIR" \
    "$IMAGE_NAME:$IMAGE_TAG" \
    --dangerously-skip-permissions \
    "$@"
