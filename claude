#!/usr/bin/env bash
# Wrapper that runs Claude Code inside a podman container.
# Drop this in ~/.local/bin/claude (or any directory on your PATH) and chmod +x it.
#
# Usage: claude [any claude-code args]

set -euo pipefail

IMAGE_NAME="claude-cli"
IMAGE_TAG="latest"

# Session state: settings, history, credentials.
CLAUDE_HOME="$HOME/.cache/claude-home"

# ── Workspace ─────────────────────────────────────────────────────────────────
HOST_WORKDIR="$PWD"
PROJECT_NAME="$(basename "$PWD")"
CONTAINER_WORKDIR="/home/claude/workspace/$PROJECT_NAME"

# ── Host path mounts ──────────────────────────────────────────────────────────
# Relabeling needs the SELinux module loaded; with SELinux off it fails with
# EPERM. The shared label 'z' is required, not the private 'Z': a private label
# would stop a second container from mounting the same host directory, so two
# agents could not work in one code base at the same time.
SHARED_LABEL_OPTS=()
if [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]]; then
    SHARED_LABEL_OPTS=(z)
fi

# Ordered podman mount arguments. Later entries overlay earlier ones.
MOUNTS=()

# add_bind_mount <host path> <container path> [mount option …]
add_bind_mount() {
    local host_path="$1" container_path="$2"
    shift 2
    local -a opts=("$@" "${SHARED_LABEL_OPTS[@]}")
    local spec="$host_path:$container_path"
    if (( ${#opts[@]} )); then
        local IFS=,
        spec+=":${opts[*]}"
    fi
    MOUNTS+=(-v "$spec")
}

EMPTY_DIR_OPTS="ro,noexec,nosuid,nodev"

# add_empty_dir <container path>
add_empty_dir() {
    MOUNTS+=(--tmpfs "$1:$EMPTY_DIR_OPTS")
}

# ── TTY detection ─────────────────────────────────────────────────────────────
# -it only for a real terminal, so that  echo … | claude  keeps working.
TTY_FLAGS=()
if [[ -t 0 ]]; then
    TTY_FLAGS=(-it)
fi

# Paths that exist in the container as a mount only. They are excluded from git
# in the snapshot below.
MOUNT_ONLY_RELPATHS=(
    'planning'
)

# ── Secret masking ────────────────────────────────────────────────────────────
# A bind mount cannot exclude a sub-path, so every secret under the mounted
# working directory is covered by a second mount:
#   * a .json file    -> a read-only stub holding "{}", so a parser still works
#   * any other file  -> /dev/null, read-only
#   * a directory     -> an empty read-only tmpfs
# The name stays visible, the content does not. Masks are passed to podman last
# so they overlay the parent mounts. No :z on them: /dev/null must not be
# relabeled and a tmpfs needs no label.

# Hidden by base name.
SECRET_FILE_GLOBS=(
    '.env' '.env.*'
    '.netrc' '.npmrc' '.pgpass' '.htpasswd' '.dockercfg'
    '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.keystore'
    'id_rsa*' 'id_ecdsa*' 'id_ed25519*'
    'credentials' 'credentials.json' 'service-account*.json'
    'secrets.yml' 'secrets.yaml' 'secrets.json'
)

# Hidden by path, for names that are only sensitive in a certain place. A
# project-local Claude settings file can grant permissions and register hooks,
# so the container takes its rules from the mounted Claude home dir instead.
SECRET_PATH_GLOBS=(
    '.claude/settings*.json'
)

# Templates that hold no real values and stay visible.
SECRET_FILE_KEEP=(
    '.env.example' '.env.sample' '.env.dist' '.env.template'
    '*.pem.example' '*.key.example'
)

SECRET_DIR_GLOBS=(
    '.ssh' '.gnupg' '.aws' '.kube' '.docker' '.gcloud'
    'secrets' 'secret'
)

# Never searched: large, or mounted separately.
SECRET_SKIP_DIRS=(
    '.git' 'node_modules' 'vendor' 'dist' 'build' '.cache'
)

# An empty file makes some readers report a parse error, so the stub holds {}.
MASK_STUB_JSON="$CLAUDE_HOME/.mask/empty.json"
mkdir -p "$(dirname "$MASK_STUB_JSON")"
rm -f "$MASK_STUB_JSON"
printf "{}\\n" > "$MASK_STUB_JSON"
chmod 444 "$MASK_STUB_JSON"

SECRET_MASKS=()

# Masked paths relative to the workspace root, for the git snapshot below.
MASK_RELPATHS=()

# mask_tree <host root> <container root> <prefix below the workspace root>
mask_tree() {
    local host_root="$1" container_root="$2" prefix="${3:-}"
    [[ -d "$host_root" ]] || return 0

    local -a find_args=("$host_root" -maxdepth 6)

    # Prune the skip list first so it also applies to the directory matches.
    local first=1 d
    find_args+=(\()
    for d in "${SECRET_SKIP_DIRS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-name "$d")
        first=0
    done
    find_args+=(\) -prune -o)

    # Secret directories, without descending into them.
    first=1
    find_args+=(-type d \()
    for d in "${SECRET_DIR_GLOBS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-name "$d")
        first=0
    done
    find_args+=(\) -prune -print -o)

    # Secret files by base name, minus the templates.
    first=1
    find_args+=(-type f \()
    for d in "${SECRET_FILE_GLOBS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-name "$d")
        first=0
    done
    find_args+=(\))
    for d in "${SECRET_FILE_KEEP[@]}"; do
        find_args+=(! -name "$d")
    done
    find_args+=(-print -o)

    # Secret files by path, tried at the root and below it.
    first=1
    find_args+=(-type f \()
    for d in "${SECRET_PATH_GLOBS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-path "$host_root/$d" -o -path "$host_root/*/$d")
        first=0
    done
    find_args+=(\) -print)

    local path rel stub
    while IFS= read -r path; do
        rel="${path#"$host_root"/}"
        if [[ -d "$path" ]]; then
            SECRET_MASKS+=(--tmpfs "$container_root/$rel:$EMPTY_DIR_OPTS")
        else
            [[ "$path" == *.json ]] && stub="$MASK_STUB_JSON" || stub="/dev/null"
            SECRET_MASKS+=(-v "$stub:$container_root/$rel:ro")
        fi
        MASK_RELPATHS+=("${prefix:+$prefix/}$rel")
    done < <(find "${find_args[@]}" 2>/dev/null)
}

mask_tree "$HOST_WORKDIR" "$CONTAINER_WORKDIR" ""
mask_tree "$HOME/planning" "$CONTAINER_WORKDIR/planning" "planning"

# A writable mask would swallow an edit made in the container, and the
# skip-worktree bits below would keep it out of git status as well.
for spec in "${SECRET_MASKS[@]}"; do
    case "$spec" in
        -v|--tmpfs|*:ro|*:ro,*) ;;
        *) echo "claude: mask is not read-only, refusing to start: $spec" >&2; exit 1 ;;
    esac
done

# ── Git snapshot ──────────────────────────────────────────────────────────────
# The container gets a private read-only copy of the git dir, so git log/diff/
# status work while add/commit/push fail. The copy is what makes the mounts of
# this wrapper invisible to git: skip-worktree on every tracked path a mask
# covers, and an exclude entry for the rest. It lives inside the host .git dir,
# which keeps cp -al on one filesystem and out of the workspace listing.
add_git_snapshot_mount() {
    local gitdir="$HOST_WORKDIR/.git"
    [[ -d "$gitdir" ]] || return 0

    local snap="$gitdir/claude-snapshot.$$"

    # No trap can run after the exec below. exec keeps this PID for the
    # container, so a snapshot with a dead PID is from a finished session.
    local old pid
    for old in "$gitdir"/claude-snapshot.*; do
        [[ -d "$old" ]] || continue
        pid="${old##*.}"
        if [[ "$pid" == "$$" ]] || ! kill -0 "$pid" 2>/dev/null; then
            rm -rf "$old"
        fi
    done
    find "$gitdir" -maxdepth 1 -name 'claude-snapshot.*' -mtime +0 \
        -exec rm -rf {} + 2>/dev/null || true
    mkdir -p "$snap"

    local entry name
    for entry in "$gitdir"/* "$gitdir"/.[!.]*; do
        [[ -e "$entry" ]] || continue
        name="${entry##*/}"
        [[ "$name" == claude-snapshot.* ]] && continue
        cp -al "$entry" "$snap/" 2>/dev/null || cp -a "$entry" "$snap/"
    done

    # Break the hardlinks on the files written below, or the writes land in the
    # host repository.
    local -a git_cmd=(git --git-dir="$snap" --work-tree="$HOST_WORKDIR")
    mkdir -p "$snap/info"
    local f
    for f in "$snap/index" "$snap/info/exclude"; do
        [[ -f "$f" ]] || continue
        cp "$f" "$f.claude" && mv -f "$f.claude" "$f"
    done
    printf '\n# claude wrapper: masked and mount-only paths\n' >> "$snap/info/exclude"

    # The list goes through a file because command substitution drops the NUL
    # separators. A path ls-files does not return is not in the index, where
    # update-index would fail, so it becomes an exclude entry.
    local rel list
    list="$(mktemp)"
    for rel in "${MASK_RELPATHS[@]}"; do
        "${git_cmd[@]}" ls-files -z -- "$rel" > "$list" 2>/dev/null || true
        if [[ -s "$list" ]]; then
            xargs -0 -r "${git_cmd[@]}" update-index --skip-worktree -- < "$list"
        else
            printf '/%s\n' "$rel" >> "$snap/info/exclude"
        fi
    done
    rm -f "$list"

    for rel in "${MOUNT_ONLY_RELPATHS[@]}"; do
        printf '/%s\n' "$rel" >> "$snap/info/exclude"
    done

    add_bind_mount "$snap" "$CONTAINER_WORKDIR/.git" ro
}

add_bind_mount "$CLAUDE_HOME" /home/claude
add_bind_mount "$HOST_WORKDIR" "$CONTAINER_WORKDIR"
add_git_snapshot_mount
add_bind_mount "$HOME/planning" "$CONTAINER_WORKDIR/planning"
add_empty_dir "$CONTAINER_WORKDIR/planning/.git"

# ── Run ───────────────────────────────────────────────────────────────────────
# Masks come last so they overlay the mounts above. --network=bridge keeps the
# container off the host's own LAN address, behind NAT.
exec podman run \
    "${TTY_FLAGS[@]}" \
    --rm \
    --userns=keep-id \
    --cap-drop=ALL \
    --security-opt=no-new-privileges:true \
    --network=bridge \
    "${MOUNTS[@]}" \
    "${SECRET_MASKS[@]}" \
    --workdir "$CONTAINER_WORKDIR" \
    "$IMAGE_NAME:$IMAGE_TAG" \
    --dangerously-skip-permissions \
    "$@"
