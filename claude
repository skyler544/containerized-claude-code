#!/usr/bin/env bash
# Wrapper that runs Claude CLI inside a Docker container.
# Drop this in ~/.local/bin/claude (or any directory on your PATH) and chmod +x it.
#
# Usage: claude [any claude-code args]
#   e.g. claude
#        claude --help
#        claude "explain this codebase"

set -euo pipefail

IMAGE_NAME="claude-cli"
IMAGE_TAG="latest"

# ── Auth state ───────────────────────────────────────────────────────────────
# Claude home dir is bind-mounted for session config, but credentials are kept
# in a separate read-only location and injected via a dedicated bind mount so
# that they are never writable from inside the container.
#
# Layout expected on the host:
#   ~/.cache/claude-home/        – mutable session state (settings, history …)
#   ~/.cache/claude-credentials/ – read-only auth tokens (.claude/credentials.json)
#
# First-time setup: run  mkdir -p ~/.cache/claude-credentials/.claude
# then copy (or move) ~/.cache/claude-home/.claude/credentials.json there.
CLAUDE_HOME="$HOME/.cache/claude-home"
CLAUDE_CREDS_DIR="$HOME/.cache/claude-credentials"

# ── Workspace ─────────────────────────────────────────────────────────────────
# Mount the current working directory into the container as ~/workspace/<dirname>
HOST_WORKDIR="$PWD"
PROJECT_NAME="$(basename "$PWD")"
CONTAINER_WORKDIR="/home/claude/workspace/$PROJECT_NAME"

# ── SELinux ───────────────────────────────────────────────────────────────────
# :Z relabeling requires the SELinux kernel module to be loaded. When SELinux is
# fully disabled (not just permissive), lsetxattr fails with EPERM.
Z=""
if [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]]; then
    Z=",z"
fi

# ── TTY detection ─────────────────────────────────────────────────────────────
# Pass -it only when stdin is a real terminal (interactive session).
# Without this, piping into claude (e.g. echo "..." | claude) would break.
TTY_FLAGS=()
if [[ -t 0 ]]; then
    TTY_FLAGS=(-it)
fi

# ── Git read-only mount ────────────────────────────────────────────────────────
# If the workspace has a .git dir, mount it read-only so git log/diff/status
# work but git add/commit/push always fail with a permission error.
# Skipped when there is no .git to avoid Docker creating a spurious empty dir.
GIT_MOUNT=()
if [[ -d "$HOST_WORKDIR/.git" ]]; then
    GIT_MOUNT=(-v "$HOST_WORKDIR/.git:$CONTAINER_WORKDIR/.git:ro$Z")
fi

# ── Secret masking ────────────────────────────────────────────────────────────
# The whole working directory is bind-mounted, so secret files inside it would
# be readable in the container. A bind mount cannot exclude a sub-path, so each
# secret is instead covered by a second mount:
#   * a .json file -> a read-only stub that holds "{}", so a parser still works
#   * any other file -> /dev/null, read-only, which reads as empty
#   * a directory  -> an empty tmpfs
# The name still appears in listings, but the content never enters the
# container. Masks are passed last so they overlay the parent mounts.
#
# No SELinux :z on these: /dev/null must not be relabeled, and a tmpfs needs no
# label of ours. The stub sits in the Claude home dir, which is already mounted.

# Glob patterns of files to hide, matched against the base name only.
SECRET_FILE_GLOBS=(
    '.env' '.env.*'
    '.netrc' '.npmrc' '.pgpass' '.htpasswd' '.dockercfg'
    '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.keystore'
    'id_rsa*' 'id_ecdsa*' 'id_ed25519*'
    'credentials' 'credentials.json' 'service-account*.json'
    'secrets.yml' 'secrets.yaml' 'secrets.json'
)

# Patterns matched against the path below the mount root, for names that are
# only sensitive in a certain place. A project-local Claude settings file can
# grant permissions and register hooks, so the container must not read it: the
# container gets its rules from the mounted Claude home dir instead.
SECRET_PATH_GLOBS=(
    '.claude/settings*.json'
)

# Templates that hold no real values and stay visible.
SECRET_FILE_KEEP=(
    '.env.example' '.env.sample' '.env.dist' '.env.template'
    '*.pem.example' '*.key.example'
)

# Directory names to replace with an empty tmpfs.
SECRET_DIR_GLOBS=(
    '.ssh' '.gnupg' '.aws' '.kube' '.docker' '.gcloud'
    'secrets' 'secret'
)

# Directories that are never searched: large, or mounted separately.
SECRET_SKIP_DIRS=(
    '.git' 'node_modules' 'vendor' 'dist' 'build' '.cache'
)

# Stub for masked JSON files. An empty file makes some readers report a parse
# error, so an empty object is used instead.
MASK_STUB_JSON="$CLAUDE_HOME/.mask/empty.json"
mkdir -p "$(dirname "$MASK_STUB_JSON")"
rm -f "$MASK_STUB_JSON"
printf "{}\\n" > "$MASK_STUB_JSON"
chmod 444 "$MASK_STUB_JSON"

SECRET_MASKS=()

# mask_tree <host root> <container root>
# Finds secrets under the host root and appends the matching mounts.
mask_tree() {
    local host_root="$1" container_root="$2"
    [[ -d "$host_root" ]] || return 0

    local -a find_args=("$host_root" -maxdepth 6)

    # Prune the skip list first so it also applies to the directory matches.
    local first=1 d
    find_args+=(\()
    for d in "${SECRET_SKIP_DIRS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-name "$d")
        first=0
    done
    find_args+=(\) -prune -o)

    # Secret directories: print and do not descend into them.
    first=1
    find_args+=(-type d \()
    for d in "${SECRET_DIR_GLOBS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-name "$d")
        first=0
    done
    find_args+=(\) -prune -print -o)

    # Secret files by base name, minus the templates that stay visible.
    first=1
    find_args+=(-type f \()
    for d in "${SECRET_FILE_GLOBS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-name "$d")
        first=0
    done
    find_args+=(\))
    for d in "${SECRET_FILE_KEEP[@]}"; do
        find_args+=(! -name "$d")
    done
    find_args+=(-print -o)

    # Secret files by path. Each pattern is tried at the root and below it.
    first=1
    find_args+=(-type f \()
    for d in "${SECRET_PATH_GLOBS[@]}"; do
        [[ $first == 1 ]] || find_args+=(-o)
        find_args+=(-path "$host_root/$d" -o -path "$host_root/*/$d")
        first=0
    done
    find_args+=(\) -print)

    local path rel stub
    while IFS= read -r path; do
        rel="${path#"$host_root"/}"
        if [[ -d "$path" ]]; then
            SECRET_MASKS+=(--tmpfs "$container_root/$rel:noexec,nosuid,nodev")
        else
            [[ "$path" == *.json ]] && stub="$MASK_STUB_JSON" || stub="/dev/null"
            SECRET_MASKS+=(-v "$stub:$container_root/$rel:ro")
        fi
        if [[ -n "${CLAUDE_MASK_VERBOSE:-}" ]]; then
            echo "claude: hiding $rel" >&2
        fi
    done < <(find "${find_args[@]}" 2>/dev/null)
}

mask_tree "$HOST_WORKDIR" "$CONTAINER_WORKDIR"
mask_tree "$HOME/planning" "$CONTAINER_WORKDIR/planning"

# ── Run ───────────────────────────────────────────────────────────────────────
exec podman run \
    "${TTY_FLAGS[@]}" \
    --rm \
    --userns=keep-id \
    --cap-drop=ALL \
    --security-opt=no-new-privileges:true \
    -v "$CLAUDE_HOME:/home/claude$Z" \
    -v "$CLAUDE_CREDS_DIR/.claude/credentials.json:/home/claude/.claude/credentials.json:ro$Z" \
    -v "$HOST_WORKDIR:$CONTAINER_WORKDIR$Z" \
    "${GIT_MOUNT[@]}" \
    -v "$HOME/planning:$CONTAINER_WORKDIR/planning$Z" \
    --tmpfs "$CONTAINER_WORKDIR/planning/.git:noexec,nosuid,nodev" \
    "${SECRET_MASKS[@]}" \
    --workdir "$CONTAINER_WORKDIR" \
    "$IMAGE_NAME:$IMAGE_TAG" \
    --dangerously-skip-permissions \
    "$@"
