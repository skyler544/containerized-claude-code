#!/usr/bin/env bash
set -euo pipefail

IMAGE_NAME="claude-cli"
IMAGE_TAG="latest"

CLAUDE_HOME="$HOME/.cache/claude-home"

# ── Agent rules ───────────────────────────────────────────────────────────────
# The user level rules are this repository's CLAUDE.md. Every project gets the
# same file, and every start gets the committed state.
WRAPPER_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
RULES_FILE="$WRAPPER_DIR/CLAUDE.md"
CONTAINER_RULES_FILE="/home/claude/.claude/CLAUDE.md"

if [[ ! -f "$RULES_FILE" ]]; then
    printf 'claude: no rules file at %s\n' "$RULES_FILE" >&2
    exit 1
fi

# ── Workspace ─────────────────────────────────────────────────────────────────
HOST_WORKDIR="$PWD"
PROJECT_NAME="$(basename "$PWD")"
CONTAINER_WORKDIR="/home/claude/workspace/$PROJECT_NAME"

# ── Host path mounts ──────────────────────────────────────────────────────────
SHARED_LABEL_OPTS=()
if [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]]; then
    SHARED_LABEL_OPTS=(z)
fi

MOUNTS=()

add_bind_mount() {
    local host_path="$1" container_path="$2"
    shift 2
    local -a opts=("$@" "${SHARED_LABEL_OPTS[@]}")
    local spec="$host_path:$container_path"
    if (( ${#opts[@]} )); then
        local IFS=,
        spec+=":${opts[*]}"
    fi
    MOUNTS+=(-v "$spec")
}

# A tmpfs is not usable for a mask. Podman applies a --tmpfs before the bind
# mount of the working directory, thus the bind mount covers it again and the
# host's files come back. A bind mount of an empty directory keeps its place.

# ── TTY detection ─────────────────────────────────────────────────────────────
TTY_FLAGS=()
if [[ -t 0 ]]; then
    TTY_FLAGS=(-it)
fi

# ── Session files ─────────────────────────────────────────────────────────────
# The wrapper builds the exclude lists at every start. Each session gets one
# directory. A directory whose process is gone is removed.
SESSION_DIR="$CLAUDE_HOME/.mask/session.$$"
CONTAINER_SESSION_DIR="/home/claude/.mask/session.$$"
EXCLUSIONS_FILE="$SESSION_DIR/exclusions"

remove_finished_session_dirs() {
    local dir pid
    for dir in "$CLAUDE_HOME/.mask"/session.*; do
        [[ -d "$dir" ]] || continue
        pid="${dir##*.}"
        if [[ "$pid" == "$$" ]] || ! kill -0 "$pid" 2>/dev/null; then
            rm -rf "$dir"
        fi
    done
}

SESSION_FILE_COUNT=0
SESSION_FILE=""

# Puts the next free name in SESSION_FILE. Do not call this in a command
# substitution, because a subshell loses the count.
session_file() {
    SESSION_FILE="$SESSION_DIR/$1.$SESSION_FILE_COUNT"
    SESSION_FILE_COUNT=$((SESSION_FILE_COUNT + 1))
}

mkdir -p "$CLAUDE_HOME/.mask"
remove_finished_session_dirs
mkdir -p "$SESSION_DIR"
: > "$EXCLUSIONS_FILE"

# ── Secret masking ────────────────────────────────────────────────────────────
SECRET_FILE_GLOBS=(
    '.env' '.env.*'
    '.netrc' '.npmrc' '.pgpass' '.htpasswd' '.dockercfg'
    '*.pem' '*.key' '*.p12' '*.pfx' '*.jks' '*.keystore'
    'id_rsa*' 'id_ecdsa*' 'id_ed25519*'
    'credentials' 'credentials.json' 'service-account*.json'
    'secrets.yml' 'secrets.yaml' 'secrets.json'
)
SECRET_PATH_GLOBS=(
    '.claude/settings*.json'
)
SECRET_DIR_GLOBS=(
    '.ssh' '.gnupg' '.aws' '.kube' '.docker' '.gcloud'
    'secrets' 'secret'
)
SECRET_TEMPLATE_GLOBS=(
    '*.example' '*.sample' '*.dist' '*.template'
)
SECRET_SKIP_DIRS=(
    '.git' 'node_modules' 'vendor' 'dist' 'build' '.cache'
)

MASK_SEARCH_DEPTH=6
EMPTY_FILE="/dev/null"

SECRET_MASKS=()
WORKSPACE_EXCLUDE_RELPATHS=()
PLANNING_EXCLUDE_RELPATHS=()

# A secret file reads as empty, and a write to it goes to /dev/null. Nothing of
# the host's file reaches the container, and nothing goes back.
mask_file() {
    SECRET_MASKS+=(-v "$EMPTY_FILE:$1")
}

# A secret directory reads as empty. A write to it lands in the session
# directory, which the next start removes. It never reaches the project.
empty_directory() {
    session_file empty
    mkdir -p "$SESSION_FILE"
}

mask_dir() {
    empty_directory
    SECRET_MASKS+=(-v "$SESSION_FILE:$1")
}

# A settings file must not exist in the container at all, because its content
# changes how the agent works. A mount cannot remove one name from a mounted
# directory, thus the wrapper puts a tmpfs over the whole directory and mounts
# each other entry of it back on top. Writes to the hidden names stay in the
# tmpfs.
hide_paths() {
    local host_root="$1" container_root="$2"
    shift 2
    local rel parent entry name hidden
    local -A parents=()

    for rel in "$@"; do
        [[ "$rel" == */* ]] || continue
        parents["${rel%/*}"]=1
    done

    for parent in "${!parents[@]}"; do
        empty_directory
        SECRET_MASKS+=(-v "$SESSION_FILE:$container_root/$parent")
        for entry in "$host_root/$parent"/* "$host_root/$parent"/.[!.]*; do
            [[ -e "$entry" ]] || continue
            name="${entry##*/}"
            hidden=0
            for rel in "$@"; do
                [[ "$rel" == "$parent/$name" ]] && hidden=1
            done
            (( hidden )) && continue
            SECRET_MASKS+=(-v "$entry:$container_root/$parent/$name")
            # A mount can change the type of a path. Podman follows a symlink
            # and gives the container a directory, thus git would report the
            # tracked symlink as deleted. The list keeps it quiet.
            record_exclusion "$container_root" "$parent/$name"
        done
    done
}

append_glob_group() {
    local -n group_out="$1"
    local predicate="$2"
    shift 2
    local first=1 glob
    group_out+=('(')
    for glob in "$@"; do
        (( first )) || group_out+=(-o)
        group_out+=("$predicate" "$glob")
        first=0
    done
    group_out+=(')')
}

# Every path that the container does not get must also stay out of git status.
# The container's git shim reads this list and sets a skip-worktree bit for
# each tracked path in it.
record_exclusion() {
    printf '%s\t%s\n' "$1" "$2" >> "$EXCLUSIONS_FILE"
}

mask_tree() {
    local host_root="$1" container_root="$2"
    local -n relpaths_out="$3"
    [[ -d "$host_root" ]] || return 0

    local path rel glob
    local -a hidden_args=("$host_root" -maxdepth "$MASK_SEARCH_DEPTH")
    append_glob_group hidden_args -name "${SECRET_SKIP_DIRS[@]}"
    hidden_args+=(-prune -o -type f)

    local -a path_globs=()
    for glob in "${SECRET_PATH_GLOBS[@]}"; do
        path_globs+=("$host_root/$glob" "$host_root/*/$glob")
    done
    append_glob_group hidden_args -path "${path_globs[@]}"
    hidden_args+=(-print)

    local -a hidden=()
    while IFS= read -r path; do
        hidden+=("${path#"$host_root"/}")
    done < <(find "${hidden_args[@]}" 2>/dev/null)

    if (( ${#hidden[@]} )); then
        hide_paths "$host_root" "$container_root" "${hidden[@]}"
        for rel in "${hidden[@]}"; do
            relpaths_out+=("$rel")
            record_exclusion "$container_root" "$rel"
        done
    fi

    local -a find_args=("$host_root" -maxdepth "$MASK_SEARCH_DEPTH")

    append_glob_group find_args -name "${SECRET_SKIP_DIRS[@]}"
    find_args+=(-prune -o)

    find_args+=(-type d)
    append_glob_group find_args -name "${SECRET_DIR_GLOBS[@]}"
    find_args+=(-prune -print -o)

    # A template holds no secret and must stay readable.
    find_args+=(-type f)
    append_glob_group find_args -name "${SECRET_TEMPLATE_GLOBS[@]}"
    find_args+=(-o)

    find_args+=(-type f)
    append_glob_group find_args -name "${SECRET_FILE_GLOBS[@]}"
    find_args+=(-print)

    while IFS= read -r path; do
        rel="${path#"$host_root"/}"
        if [[ -d "$path" ]]; then
            mask_dir "$container_root/$rel"
        else
            mask_file "$container_root/$rel"
        fi
        relpaths_out+=("$rel")
        record_exclusion "$container_root" "$rel"
    done < <(find "${find_args[@]}" 2>/dev/null)
}

# ── Git state ─────────────────────────────────────────────────────────────────
# The container gets the host's own git directory, read only. All reads keep
# working. All writes fail. A branch switch or a rebase on the host is visible
# immediately.
OBSOLETE_SNAPSHOT_PREFIX="claude-session"
GIT_EXCLUDE_RELPATHS=()
NO_EXTRA_EXCLUDES=()

remove_obsolete_snapshots() {
    local gitdir="$1" snapshot
    for snapshot in "$gitdir/$OBSOLETE_SNAPSHOT_PREFIX".*; do
        [[ -e "$snapshot" ]] && rm -rf "$snapshot"
    done
    return 0
}

# An untracked path that the container does not get would show up as untracked
# work. An exclude file keeps it quiet. The host's own rules keep their effect,
# because their content comes first.
add_exclude_file() {
    local gitdir="$1" container_git="$2"
    local -n excluded="$3"
    local -n extra="$4"
    local host_exclude="$gitdir/info/exclude"
    local exclude rel
    session_file exclude
    exclude="$SESSION_FILE"

    if [[ -f "$host_exclude" ]]; then
        cat "$host_exclude" > "$exclude"
    else
        # The mount needs a target, and git itself ships this file.
        mkdir -p "$gitdir/info"
        : > "$host_exclude"
        : > "$exclude"
    fi

    printf '\n# claude wrapper: masked and mounted paths\n' >> "$exclude"
    for rel in ${excluded[@]+"${excluded[@]}"} ${extra[@]+"${extra[@]}"}; do
        printf '/%s\n' "$rel" >> "$exclude"
    done

    add_bind_mount "$exclude" "$container_git/info/exclude" ro
}

add_git_mount() {
    local worktree="$1" container_path="$2" excluded_name="$3" extra_name="$4"
    local gitdir="$worktree/.git"
    [[ -d "$gitdir" ]] || return 0

    remove_obsolete_snapshots "$gitdir"
    add_bind_mount "$gitdir" "$container_path/.git" ro
    add_exclude_file "$gitdir" "$container_path/.git" "$excluded_name" "$extra_name"
}

planning_directory() {
    local host_path="$1" name="$2"
    local container_path="$CONTAINER_WORKDIR/$name"

    add_bind_mount "$host_path" "$container_path"
    mask_tree "$host_path" "$container_path" PLANNING_EXCLUDE_RELPATHS
    add_git_mount "$host_path" "$container_path" PLANNING_EXCLUDE_RELPATHS NO_EXTRA_EXCLUDES
    GIT_EXCLUDE_RELPATHS+=("$name")
}

# The workspace mount point lies inside the claude home. Podman would create it
# as the root of the user namespace, and the host user could then not remove it.
mkdir -p "$CLAUDE_HOME/workspace/$PROJECT_NAME"
mkdir -p "$CLAUDE_HOME/.claude"

add_bind_mount "$CLAUDE_HOME" /home/claude
# Read only, thus a write by the agent fails and the repository stays the one
# source of the rules.
add_bind_mount "$RULES_FILE" "$CONTAINER_RULES_FILE" ro
add_bind_mount "$HOST_WORKDIR" "$CONTAINER_WORKDIR"
mask_tree "$HOST_WORKDIR" "$CONTAINER_WORKDIR" WORKSPACE_EXCLUDE_RELPATHS
planning_directory "$HOME/planning" planning
add_git_mount "$HOST_WORKDIR" "$CONTAINER_WORKDIR" WORKSPACE_EXCLUDE_RELPATHS GIT_EXCLUDE_RELPATHS

# ── Run ───────────────────────────────────────────────────────────────────────
COMMAND=(
    podman run
    "${TTY_FLAGS[@]}"
    --rm
    --userns=keep-id
    --cap-drop=ALL
    --security-opt=no-new-privileges:true
    --network=bridge
    --env "CLAUDE_MASK_DIR=$CONTAINER_SESSION_DIR"
    "${MOUNTS[@]}"
    "${SECRET_MASKS[@]}"
    --workdir "$CONTAINER_WORKDIR"
    "$IMAGE_NAME:$IMAGE_TAG"
    --dangerously-skip-permissions
    "$@"
)

# CLAUDE_PRINT_COMMAND=1 shows what the wrapper would run, one argument per
# line, and starts no container.
if [[ -n "${CLAUDE_PRINT_COMMAND:-}" ]]; then
    printf '%s\n' "${COMMAND[@]}"
    exit 0
fi

exec "${COMMAND[@]}"
